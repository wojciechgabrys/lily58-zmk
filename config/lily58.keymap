#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mt {
    tapping-term-ms = <300>;
    quick-tap-ms = <200>;
};

&lt {
    quick-tap-ms = <200>;
    tapping-term-ms = <300>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        gresc: grave_escape {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;

            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <13 14>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <25 26>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <37 38>;
        };

        brace_left {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <26 27>;
        };

        brace_right {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <32 33>;
        };

        bracket_left {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <38 39>;
        };

        bracket_right {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <46 47>;
        };

        parenthesis_left {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <28 27>;
        };

        parenthesis_right {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <31 32>;
        };

        less_than {
            bindings = <&kp LESS_THAN>;
            key-positions = <40 39>;
        };

        greater_than {
            bindings = <&kp GREATER_THAN>;
            key-positions = <45 46>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <22 21>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&trans  &trans       &trans          &trans          &trans        &trans                                 &trans           &trans            &trans          &trans          &trans          &trans
&trans  &kp Q        &kp W           &kp E           &kp R         &kp T                                  &kp Y            &kp U             &kp I           &kp O           &kp P           &trans
&trans  &hm LCTRL A  &hm LEFT_ALT S  &hm LEFT_GUI D  &hm LSHIFT F  &kp G                                  &kp H            &hm LEFT_SHIFT J  &hm LEFT_GUI K  &hm LEFT_ALT L  &hm RCTRL SEMI  &trans
&trans  &kp Z        &kp X           &kp C           &kp V         &kp B        &trans       &trans       &kp N            &kp M             &kp COMMA       &kp DOT         &kp FSLH        &trans
                                     &trans          &lt 0 ESCAPE  &lt 0 SPACE  &lt 0 TAB    &lt 0 ENTER  &lt 0 BACKSPACE  &lt 0 DELETE      &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <1 1>;
            then-layer = <1>;
        };
    };
};
