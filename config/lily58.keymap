#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <300>;
    quick-tap-ms = <200>;
};

&lt {
    quick-tap-ms = <200>;
    tapping-term-ms = <300>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        gresc: grave_escape {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;

            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <28 31>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <13 14>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <37 38>;
        };

        brace_left {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <15 14>;
        };

        brace_right {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <21 20>;
        };

        bracket_left {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <38 39>;
        };

        bracket_right {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <46 47>;
        };

        parenthesis_left {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 15>;
        };

        parenthesis_right {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
        };

        less_than {
            bindings = <&kp LESS_THAN>;
            key-positions = <40 39>;
        };

        greater_than {
            bindings = <&kp GREATER_THAN>;
            key-positions = <45 46>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <22 21>;
        };

        alternative_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <31 32 33>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&trans  &kp N1       &kp N2          &kp N3          &kp N4        &kp N5                                 &kp N6           &kp N7            &kp N8          &kp N9          &kp N0                &trans
&trans  &kp Q        &kp W           &kp E           &kp R         &kp T                                  &kp Y            &kp U             &kp I           &kp O           &kp P                 &trans
&trans  &hm LCTRL A  &hm LEFT_ALT S  &hm LEFT_GUI D  &hm LSHIFT F  &kp G                                  &kp H            &hm LEFT_SHIFT J  &hm LEFT_GUI K  &hm LEFT_ALT L  &hm RCTRL APOSTROPHE  &trans
&trans  &lt 4 Z      &kp X           &kp C           &kp V         &kp B      &trans         &trans       &kp N            &kp M             &kp COMMA       &kp DOT         &lt 4 SLASH           &trans
                                     &trans          &lt 3 ESCAPE  &lt 1 TAB  &lt 2 SPACE    &lt 6 ENTER  &lt 5 BACKSPACE  &lt 7 DELETE      &trans
            >;
        };

        nav {
            bindings = <
&trans  &trans            &trans        &trans        &trans          &trans                    &trans          &trans          &trans         &trans           &trans        &trans
&trans  &trans            &trans        &trans        &trans          &trans                    &kp LG(LS(Z))   &kp LG(V)       &kp LG(C)      &kp LG(X)        &kp LG(Z)     &trans
&trans  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &trans                    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW   &kp RIGHT_ARROW  &kp CAPSLOCK  &trans
&trans  &trans            &trans        &trans        &trans          &trans  &trans    &trans  &kp INSERT      &kp HOME        &kp PAGE_DOWN  &kp PAGE_UP      &kp END       &trans
                                        &trans        &trans          &trans  &trans    &trans  &trans          &trans          &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans            &trans        &trans        &trans          &trans                       &trans          &trans          &trans        &trans           &trans     &trans
&trans  &trans            &trans        &trans        &trans          &trans                       &kp LG(LS(Z))   &kp LG(V)       &kp LG(C)     &kp LG(X)        &kp LG(Z)  &trans
&trans  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &trans                       &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans     &trans
&trans  &trans            &trans        &trans        &trans          &trans  &trans    &trans     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans     &trans
                                        &trans        &trans          &trans  &trans    &mkp RCLK  &mkp LCLK       &mkp MCLK       &trans
            >;
        };

        media {
            bindings = <
&trans  &trans     &trans    &trans    &trans     &trans                        &trans            &trans          &trans             &trans           &trans      &trans
&trans  &trans     &trans    &trans    &trans     &trans                        &trans            &trans          &trans             &trans           &trans      &trans
&trans  &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &trans                        &trans            &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT  &trans
&trans  &trans     &trans    &trans    &trans     &trans  &trans    &trans      &bt BT_SEL 0      &bt BT_SEL 1    &bt BT_SEL 2       &bt BT_SEL 3     &bt BT_CLR  &trans
                             &trans    &trans     &trans  &trans    &kp C_STOP  &kp C_PLAY_PAUSE  &kp C_MUTE      &trans
            >;
        };

        button {
            bindings = <
&trans  &trans     &trans     &trans     &trans     &trans                                      &trans                     &trans     &trans     &trans     &trans     &trans
&trans  &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LS(LG(Z))                               &kp LS(LG(Z))              &kp LG(V)  &kp LG(C)  &kp LG(X)  &kp LG(Z)  &trans
&trans  &kp LCTRL  &kp LALT   &kp LGUI   &kp LSHFT  &kp LG(LS(LEFT_BRACKET))                    &kp LG(LS(RIGHT_BRACKET))  &kp LSHFT  &kp LGUI   &kp LALT   &kp LCTRL  &trans
&trans  &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LS(LG(Z))             &trans    &trans  &kp LS(LG(Z))              &kp LG(V)  &kp LG(C)  &kp LG(X)  &kp LG(Z)  &trans
                              &trans     &trans     &trans                    &trans    &trans  &trans                     &trans     &trans
            >;
        };

        num {
            bindings = <
&trans  &trans     &trans  &trans  &trans   &trans                               &trans  &trans     &trans    &trans    &trans     &trans
&trans  &kp LBKT   &kp N7  &kp N8  &kp N9   &kp RBKT                             &trans  &trans     &trans    &trans    &trans     &trans
&trans  &kp SEMI   &kp N4  &kp N5  &kp N6   &kp EQUAL                            &trans  &kp LSHFT  &kp LGUI  &kp LALT  &kp LCTRL  &trans
&trans  &kp GRAVE  &kp N1  &kp N2  &kp N3   &kp BSLH        &trans       &trans  &trans  &trans     &trans    &trans    &trans     &trans
                           &trans  &kp DOT  &lt 1 NUMBER_0  &kp MINUS    &trans  &trans  &trans     &trans
            >;
        };

        sym {
            bindings = <
&trans  &trans          &trans           &trans        &trans                &trans                                           &trans  &trans     &trans    &trans    &trans     &trans
&trans  &kp LEFT_BRACE  &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_BRACE                                  &trans  &trans     &trans    &trans    &trans     &trans
&trans  &kp COLON       &kp DOLLAR       &kp PERCENT   &kp CARET             &kp PLUS                                         &trans  &kp LSHFT  &kp LGUI  &kp LALT  &kp LCTRL  &trans
&trans  &kp TILDE       &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp PIPE               &trans            &trans  &trans  &trans     &trans    &trans    &trans     &trans
                                         &trans        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE    &trans  &trans  &trans     &trans
            >;
        };

        fun {
            bindings = <
&trans  &trans   &trans  &trans  &trans      &trans                              &trans  &trans     &trans    &trans    &trans     &trans
&trans  &kp F12  &kp F7  &kp F8  &kp F9      &kp PRINTSCREEN                     &trans  &trans     &trans    &trans    &trans     &trans
&trans  &kp F11  &kp F4  &kp F5  &kp F6      &kp SCROLLLOCK                      &trans  &kp LSHFT  &kp LGUI  &kp LALT  &kp LCTRL  &trans
&trans  &kp F10  &kp F1  &kp F2  &kp F3      &kp PAUSE_BREAK  &trans     &trans  &trans  &trans     &trans    &trans    &trans     &trans
                         &trans  &kp C_MENU  &kp SPACE        &kp TAB    &trans  &trans  &trans     &trans
            >;
        };

        dual {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans         &trans         &trans         &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LC(LG(Q))  &kp LC(LG(W))  &kp LC(LG(E))  &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LC(LG(H))  &kp LC(LG(J))  &kp LC(LG(K))  &kp LC(LG(L))  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LC(LG(A))  &kp LC(LG(S))  &trans         &trans         &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans         &trans         &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        dual {
            if-layers = <1 5>;
            then-layer = <8>;
        };
    };
};
